mesh3 aleroninteriorpatiocentral3d=readmesh3("aleron interior patio central 3d.mesh");
plot(aleroninteriorpatiocentral3d,wait=1);

mesh3 techopatiocentral3d=readmesh3("techo patio central 3d.mesh");
plot(techopatiocentral3d,wait=1);

mesh3 pilarespatiocentral3d=readmesh3("pilares patio central 3d.mesh");
