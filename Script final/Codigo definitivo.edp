mesh3 muroprincipal3d=readmesh3("muro principal 3d.mesh");
plot(muroprincipal3d,wait=1);

mesh3 muropatiolateral3d=readmesh3("muro patio lateral 3d.mesh");
plot(muropatiolateral3d,wait=1);

mesh3 cubiertaprincipal3d=readmesh3("cubierta principal 3d.mesh");
