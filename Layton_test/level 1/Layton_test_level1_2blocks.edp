// Level 1 P1/P1: malla bibloque aguas abajo.
load "iovtk"
load "gmsh"
verbosity=0;

real reynolds=600.0;
real nu=1.0/reynolds;
real dt=0.005;
// Estabilizacion proporcional a h^2: 0.02/(2^2).
real epsP=0.005;
real Umax=1.0;
int nt=8000;
func ue=Umax*y*(10.0-y)/25.0;
func pChannel=2.0*nu*Umax*(40.0-x)/25.0;

mesh Th=gmshload("mesh_level1_2blocks_downstream.msh");
fespace Vh(Th,P1);
// Estado inicial compatible con la entrada fija y el canal desarrollado.
Vh u=ue,v=0.0,p=pChannel,q=0.0,w;
Vh uold,vold,pold,ustar,vstar,pRaw;

int[int] fieldOrder=[1,1];
real t=0.0;

for(int n=0;n<nt;n++) {
    uold=u;
    vold=v;
    pold=p;
    t+=dt;

    Vh f=convect([uold,vold],-dt,uold);
    Vh g=convect([uold,vold],-dt,vold);

    solve predictorU(u,w,init=n,solver=LU)
      = int2d(Th)(u*w/dt+nu*(dx(u)*dx(w)+dy(u)*dy(w)))
      - int2d(Th)((f/dt-dx(pold))*w)
      + on(8,u=ue)
      + on(1,2,3,4,5,7,u=0.0);

    solve predictorV(v,w,init=n,solver=LU)
      = int2d(Th)(v*w/dt+nu*(dx(v)*dx(w)+dy(v)*dy(w)))
      - int2d(Th)((g/dt-dy(pold))*w)
      + on(8,v=0.0)
      + on(1,2,3,4,5,7,v=0.0);

    ustar=u;
    vstar=v;

    solve pressureCorrection(q,w,init=n,solver=LU)
      = int2d(Th)(dx(q)*dx(w)+dy(q)*dy(w))
      - int2d(Th)((dx(ustar)+dy(vstar))*w/dt)
      + on(6,q=0.0);

    pRaw=pold-q;

    solve pressureStabilization(p,w,init=n,solver=LU)
      = int2d(Th)(p*w)
      + int2d(Th)(epsP*(dx(p)*dx(w)+dy(p)*dy(w)))
      - int2d(Th)(pRaw*w)
      + on(6,p=0.0);

    solve correctU(u,w,init=n,solver=LU)
      = int2d(Th,qft=qf1pTlump)(u*w)
      - int2d(Th,qft=qf1pTlump)((ustar+dt*dx(q))*w)
      + on(8,u=ue)
      + on(1,2,3,4,5,7,u=0.0);

    solve correctV(v,w,init=n,solver=LU)
      = int2d(Th,qft=qf1pTlump)(v*w)
      - int2d(Th,qft=qf1pTlump)((vstar+dt*dy(q))*w)
      + on(8,v=0.0)
      + on(1,2,3,4,5,7,v=0.0);

    // Salidas relevantes: inicio y t = 10, 20, 30, 40.
    if(n==0 || !((n+1)%2000)) {
        real umax=max(abs(u[].min),abs(u[].max));
        real vmax=max(abs(v[].min),abs(v[].max));
        real pmax=max(abs(p[].min),abs(p[].max));
        real divL2=sqrt(int2d(Th)((dx(u)+dy(v))^2));
        real inletError=sqrt(int1d(Th,8)((u-ue)^2+v^2));
        real wallError=sqrt(int1d(Th,1,2,3,4,5,7)(u^2+v^2));
        cout << "CHECK n=" << n << " t=" << t
             << " umax=" << umax << " vmax=" << vmax
             << " pmax=" << pmax << " divL2=" << divL2
             << " inletError=" << inletError
             << " wallError=" << wallError << endl;

        int timeLabel=round(t);
        string filename="level1_2blocks_t"+timeLabel+".vtu";
        savevtk(filename,Th,[u,v,0],p,
                dataname="Velocity Pressure",order=fieldOrder);
    }
}

cout << "LEVEL1_2BLOCKS completed t=" << t << endl;
