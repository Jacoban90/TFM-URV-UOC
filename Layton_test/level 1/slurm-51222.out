   18 : int ny1   = 8;      // Altura zona inferior [0, 1]
   19 : int nx2   = 8;      // Ancho obstáculo [5, 6]
   20 : int nx3   = 100;    // Estela horizontal [6, 40]
   21 : int nyTop = 24;     // Altura zona superior [1, 10]
   22 : 
   23 : 
   24 : /// Definición de vectores de etiquetas: [abajo, derecha, arriba, izquierda]
   25 : // Se asigna 0 a las interfaces interiores
   26 : int[int] lab1 = [1, 3, 0, 8];
   27 : int[int] lab2 = [0, 0, 7, 8];
   28 : int[int] lab3 = [4, 0, 7, 0];
   29 : int[int] lab4 = [2, 6, 0, 5];
   30 : int[int] lab5 = [0, 6, 7, 0];
   31 : 
   32 : // Construcción de bloques estructurados
   33 : mesh Th1 = square(nx1, ny1,   [5.0*x, 1.0*y],              flags=0, label=lab1);
   34 : mesh Th2 = square(nx1, nyTop, [5.0*x, 1.0 + 9.0*y],        flags=0, label=lab2);
   35 : mesh Th3 = square(nx2, nyTop, [5.0 + 1.0*x, 1.0 + 9.0*y],  flags=0, label=lab3);
   36 : mesh Th4 = square(nx3, ny1,   [6.0 + 34.0*x, 1.0*y],       flags=0, label=lab4);
   37 : mesh Th5 = square(nx3, nyTop, [6.0 + 34.0*x, 1.0 + 9.0*y], flags=0, label=lab5);
   38 : 
   39 : // 1. Unión conforme de todos los bloques
   40 : mesh Th = Th1 + Th2 + Th3 + Th4 + Th5;
   41 : 
   42 : // 2. Eliminación estricta de aristas de contorno internas
