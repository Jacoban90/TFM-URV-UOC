   56 : 
   57 : // --- Operador de Laplace para Líneas de Corriente ---
   58 : varf aStream(psii, ww) = int2d(Th)(dx(psii)*dx(ww) + dy(psii)*dy(ww))
   59 :                        + on(8, psii = psie)
