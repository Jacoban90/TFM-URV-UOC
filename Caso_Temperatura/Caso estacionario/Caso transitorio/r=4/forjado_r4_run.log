    3 : 
    4 : // Caso térmico evolutivo del recinto multicapa.
    5 : // La temperatura se aproxima con un único espacio P1 sobre una malla conforme;
    6 : // por ello es continua en las interfaces. El cambio de conductividad produce el
    7 : // cambio de pendiente esperado en las isotermas y conserva el flujo normal.
    8 : 
    9 : int r = getARGV("-r", 1);
   10 : real dt = getARGV("-dt", 2.0);
   11 : real tFinal = getARGV("-tfinal", 360.0);
   12 : real saveEvery = getARGV("-saveEvery", 30.0);
   13 : real tolNL = getARGV("-tolNL", 1.0e-8);
   14 : int maxIterNL = getARGV("-maxIterNL", 30);
   15 : 
   16 : int nx        = 100*r;
   17 : int nyAire    = 60*r;
   18 : int nyForjado = 5*r;
   19 : int nyEPS     = 2*r;
   20 : int nyBaldosa = 1*r;
   21 : 
   22 : // Orden de etiquetas de square: inferior, derecha, superior, izquierda.
   23 : int[int] labAire    = [5, 2, 6, 2];
   24 : int[int] labForjado = [6, 3, 7, 3];
   25 : int[int] labEPS     = [7, 3, 8, 3];
   26 : int[int] labBaldosa = [8, 3, 4, 3];
   27 : 
   28 : mesh mallaAire = square(
   29 :     nx, nyAire,
   30 :     [1000.0*x, -600.0 + 600.0*y],
   31 :     label=labAire, region=10, flags=1
   32 : );
   33 : 
   34 : mesh mallaForjado = square(
   35 :     nx, nyForjado,
   36 :     [1000.0*x, 25.0*y],
   37 :     label=labForjado, region=20, flags=1
   38 : );
   39 : 
   40 : mesh mallaEPS = square(
   41 :     nx, nyEPS,
   42 :     [1000.0*x, 25.0 + 6.0*y],
   43 :     label=labEPS, region=30, flags=1
   44 : );
   45 : 
   46 : mesh mallaBaldosa = square(
   47 :     nx, nyBaldosa,
   48 :     [1000.0*x, 31.0 + 3.0*y],
   49 :     label=labBaldosa, region=40, flags=1
   50 : );
   51 : 
   52 : mesh Th = mallaAire + mallaForjado + mallaEPS + mallaBaldosa;
   53 : savemesh(Th, "malla_forjado_r"+r+".mesh");
   54 : 
   55 : fespace P0h(Th, P0);
   56 : fespace Vh(Th, P1);
   57 : 
   58 : P0h reg = region;
   59 : int matBaldosa = reg(75.0, 32.0);
   60 : int matEPS     = reg(75.0, 28.0);
   61 : int matForjado = reg(75.0, 10.0);
   62 : int matAire    = reg(75.0, -100.0);
   63 : 
   64 : // Conductividad en W/(cm K).
   65 : P0h k =
   66 :       0.0100000*(region == matBaldosa)
   67 :     + 0.0002900*(region == matEPS)
   68 :     + 0.0025600*(region == matForjado)
   69 :     + 0.0002624*(region == matAire);
   70 : 
   71 : // Capacidad calorífica volumétrica rho*cp en J/(cm^3 K).
   72 : P0h rhoCp =
   73 :       0.00184800*(region == matBaldosa)
   74 :     + 0.00003500*(region == matEPS)
   75 :     + 0.00117600*(region == matForjado)
   76 :     + 0.00000118*(region == matAire);
   77 : 
   78 : real TExterior = 27.0 + 273.15;
   79 : real TSuelo    = 20.9 + 273.15;
   80 : real sigma     = 5.6704e-8*1.0e-4; // W/(cm^2 K^4)
   81 : real emisividad = 0.8;
   82 : real TCielo = 0.0552*TExterior^1.5;
   83 : real viento = 4.0;
   84 : real hExt = (5.7 + 3.8*viento)*1.0e-4; // W/(cm^2 K)
   85 : real absortividad = 1.0 - 0.80;
   86 : real radiacionSolar = 771.0*1.0e-4; // W/cm^2
   87 : 
   88 : Vh T = TExterior;
   89 : Vh TAnterior = TExterior;
   90 : Vh TIter = TExterior;
   91 : Vh v, B, error, TC;
   92 : 
   93 : problem pasoTermico(T, v, init=0, solver=sparsesolver) =
   94 :       int2d(Th)(rhoCp*T*v/dt)
   95 :     + int2d(Th)(k*(dx(T)*dx(v) + dy(T)*dy(v)))
   96 :     + int1d(Th, 4)(sigma*emisividad*B*T*v)
   97 :     + int1d(Th, 2, 3, 4)(hExt*T*v)
   98 :     - int2d(Th)(rhoCp*TAnterior*v/dt)
   99 :     - int1d(Th, 4)(sigma*emisividad*B*TCielo*v)
  100 :     - int1d(Th, 2, 3, 4)(hExt*TExterior*v)
  101 :     - int1d(Th, 4)(absortividad*radiacionSolar*v)
  102 :     + on(5, T=TSuelo);
  103 : 
  104 : real areaDominio = int2d(Th)(1.0);
  105 : int nSteps = max(1, int(tFinal/dt + 0.5));
  106 : int saveStride = max(1, int(saveEvery/dt + 0.5));
  107 : int[int] vtkOrder = [1];
  108 : 
  109 : ofstream historia("historia_termica_r"+r+".csv");
  110 : historia
  111 :     << "tiempo_s;iteraciones_no_lineales;error_no_lineal_
  ... : relativo;"
  112 :     << "incremento_RMS_K;Tmin_C;Tmax_C;T_cubierta_C;"
  113 :     << "T_baldosa_EPS_C;T_EPS_forjado_C;T_forjado_aire_C"
  114 :     << endl;
  115 : 
  116 : TC = TAnterior - 273.15;
  117 : savevtk(
  118 :     "temperatura_r"+r+"_t0000.vtk",
  119 :     Th, TC,
  120 :     order=vtkOrder,
  121 :     dataname="temperatura_C"
  122 : );
  123 : 
  124 : cout << "=============================================" << endl;
  125 : cout << "CASO EVOLUTIVO DEL FORJADO" << endl;
  126 : cout << "r=" << r << "; vertices=" << Th.nv
  127 :      << "; triangulos=" << Th.nt << endl;
  128 : cout << "dt=" << dt << " s; tFinal=" << tFinal << " s" << endl;
  129 : cout << "=============================================" << endl;
  130 : 
  131 : for (int paso = 1; paso <= nSteps; ++paso)
  132 : {
  133 :     real tiempo = paso*dt;
  134 :     TIter = TAnterior;
  135 :     T = TIter;
  136 : 
  137 :     real errorNL = 1.0;
  138 :     real incrementoRMS = 0.0;
  139 :     int iterNL = 0;
  140 : 
  141 :     while ((errorNL > tolNL) && (iterNL < maxIterNL))
  142 :     {
  143 :         B = (TIter^2 + TCielo^2)*(TIter + TCielo);
  144 :         pasoTermico;
  145 : 
  146 :         error = T - TIter;
  147 :         real normaError2 = int2d(Th)(error^2);
  148 :         real normaT2 = int2d(Th)(T^2);
  149 :         errorNL = sqrt(normaError2/max(normaT2, 1.0e-30));
  150 :         incrementoRMS = sqrt(normaError2/areaDominio);
  151 : 
  152 :         TIter = T;
  153 :         iterNL += 1;
  154 :     }
  155 : 
  156 :     if (iterNL >= maxIterNL)
  157 :     {
  158 :         cout << "AVISO: maxIterNL alcanzado en t=" << tiempo
  159 :              << " s; errorNL=" << errorNL << endl;
  160 :     }
  161 : 
  162 :     TAnterior = T;
  163 :     TC = T - 273.15;
  164 : 
  165 :     historia
  166 :         << tiempo << ";"
  167 :         << iterNL << ";"
  168 :         << errorNL << ";"
  169 :         << incrementoRMS << ";"
  170 :         << TC[].min << ";"
  171 :         << TC[].max << ";"
  172 :         << T(300.0,34.0)-273.15 << ";"
  173 :         << T(300.0,31.0)-273.15 << ";"
  174 :         << T(300.0,25.0)-273.15 << ";"
  175 :         << T(300.0,0.0)-273.15
  176 :         << endl;
  177 : 
  178 :     if ((paso % saveStride == 0) || (paso == nSteps))
  179 :     {
  180 :         int etiquetaTiempo = int(tiempo + 0.5);
  181 :         string nombreVTK =
  182 :             "temperatura_r"+r+"_t"+etiquetaTiempo+"s.vtk";
  183 :         savevtk(
  184 :             nombreVTK,
  185 :             Th, TC,
  186 :             order=vtkOrder,
  187 :             dataname="temperatura_C"
  188 :         );
  189 : 
  190 :         cout << "t=" << tiempo << " s; iterNL=" << iterNL
  191 :              << "; errorNL=" << errorNL
  192 :              << "; Tmin=" << TC[].min
  193 :              << " C; Tmax=" << TC[].max << " C" << endl;
  194 :     }
  195 : }
  196 : 
  197 : TC = T - 273.15;
  198 : savevtk(
  199 :     "temperatura_final_r"+r+".vtk",
  200 :     Th, TC,
  201 :     order=vtkOrder,
  202 :     dataname="temperatura_C"
  203 : );
  204 : 
  205 : plot(
  206 :     TC,
  207 :     fill=1,
  208 :     value=1,
  209 :     nbiso=30,
  210 :     wait=0,
  211 :     cmm="Temperatura final (C), r="+r+", t="+tFinal+" s",
  212 :     ps="isotermas_final_r"+r+".eps"
  213 : );
  214 : 
  215 : cout << "RESULTADO FINAL r=" << r
  216 :      << "; Tmin=" << TC[].min
  217 :      << " C; Tmax=" << TC[].max
  218 :      << " C; VTK=temperatura_final_r" << r << ".vtk"
  219 :      << endl;
